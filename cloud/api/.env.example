# Local development. Copy to cloud/api/.env and fill in as needed.
ENVIRONMENT=local
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://mcpaudit:mcpaudit@localhost:5432/mcpaudit
REDIS_URL=redis://localhost:6379/0

# Accepts `Authorization: Bearer dev:you@example.com`. Refuses to start unless local.
DEV_AUTH_BYPASS=1

# Clerk (D8) -- required in staging/production
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Ours. The worker needs it; the API does not.
ANTHROPIC_API_KEY=

# 32 bytes base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
HEADER_ENC_KEY=

# Money guards
DAILY_SPEND_LIMIT_USD=25
SCAN_COST_CEILING_USD=1.00

# Billing (D9): none | dodo | polar
BILLING_PROVIDER=none
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=
DODO_PRODUCTS=pro_month:prod_test_pro_m,pro_year:prod_test_pro_y,team_month:prod_test_team_m,team_year:prod_test_team_y

RESEND_API_KEY=
SENTRY_DSN=
