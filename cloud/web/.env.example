# Public: the browser sees these.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Local development without Clerk: sends `Authorization: Bearer dev:<email>` to the API,
# which only accepts it when the API is running with ENVIRONMENT=local.
NEXT_PUBLIC_DEV_EMAIL=you@example.com

CLERK_SECRET_KEY=
